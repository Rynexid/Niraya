# ---------------------------------------------------------------------------
# Niraya API — server-side only. Never expose these values to Vite.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# PostgreSQL connection used by Drizzle and Better Auth.
DATABASE_URL=postgresql://niraya:niraya@localhost:5432/niraya
DATABASE_POOL_MAX=10

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Public URL of the API as seen by the browser.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of allowed browser origins (frontend URLs).
CORS_ORIGINS=http://localhost:5173
